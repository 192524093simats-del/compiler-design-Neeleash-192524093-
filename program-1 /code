
#include <stdio.h>
#include <ctype.h>
#include <string.h>

int main() {
    char s[500];
    int i = 0;

    printf("Enter a statement: ");
    fgets(s, sizeof(s), stdin);

    while (s[i]) {
        if (isspace(s[i])) {
            i++;
        }
        else if (s[i] == '/' && s[i+1] == '/') {
            break;
        }
        else if (isalpha(s[i]) || s[i] == '_') {
            printf("Identifier: ");
            while (isalnum(s[i]) || s[i] == '_')
                putchar(s[i++]);
            printf("\n");
        }
        else if (isdigit(s[i])) {
            printf("Constant: ");
            while (isdigit(s[i]))
                putchar(s[i++]);
            printf("\n");
        }
        else if (strchr("+-*/%=<>!", s[i])) {
            printf("Operator: %c\n", s[i++]);
        }
        else {
            i++;
        }
    }
    return 0;
}
